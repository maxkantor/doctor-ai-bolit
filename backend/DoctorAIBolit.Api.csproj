<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AWSProjectType>Lambda</AWSProjectType>
    <!-- This property makes the build directory similar to a publish directory and helps the AWS .NET Lambda Mock Test Tool find dependencies. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Generate ready to run images during publishing to improve cold start time. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Lambda requires Linux x64 runtime -->
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.AspNetCoreServer" Version="10.2.0" />
    <PackageReference Include="Amazon.Lambda.Core" Version="3.3.0" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.400.0" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="3.7.400.0" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.400.0" />
    <PackageReference Include="AWSSDK.SimpleEmail" Version="3.7.400.0" />
    <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="3.7.300" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <PackageReference Include="Stripe.net" Version="47.0.0" />
  </ItemGroup>

  <!-- Auto-create backend.zip after publish -->
  <Target Name="CreateBackendZip" AfterTargets="Publish">
    <PropertyGroup>
      <PublishDir>$(PublishDir)</PublishDir>
      <ZipOutputPath>$(MSBuildProjectDirectory)/backend.zip</ZipOutputPath>
    </PropertyGroup>
    <Message Text="📦 Creating backend.zip at $(ZipOutputPath)" Importance="high" />
    <Exec Command="cd &quot;$(PublishDir)&quot; &amp;&amp; zip -r &quot;$(ZipOutputPath)&quot; . -q" 
          Condition="'$(OS)' != 'Windows_NT'" />
    <Exec Command="powershell -Command &quot;Compress-Archive -Path '$(PublishDir)\*' -DestinationPath '$(ZipOutputPath)' -Force&quot;" 
          Condition="'$(OS)' == 'Windows_NT'" />
    <Message Text="✅ backend.zip created at $(ZipOutputPath)" Importance="high" />
  </Target>

</Project>

